{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://kimichat-app.onrender.com/api/$1"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://kimichat-app.onrender.com/uploads/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}